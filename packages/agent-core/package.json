{
  "name": "@dopilot/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic agent contracts, execution limits and untrusted-content handling.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dopilot/browser-tools": "workspace:*",
    "@dopilot/shared": "workspace:*"
  }
}
