{
  "manifest_version": 3,
  "name": "Dopilot",
  "version": "1.0.0",
  "description": "Tell your browser what to do. An open-source AI agent for tabs and pages, using your own Groq key.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "alarms", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Dopilot",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.groq.com http://127.0.0.1:4319"
  },
  "optional_permissions": ["tabs"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Dopilot, and allow one look at this tab"
    }
  }
}
