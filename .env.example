# Copy to `.env` for local development. Never commit real values.
#
# There is deliberately no GROQ_API_KEY here. Users bring their own key, which
# stays in the extension and goes directly to Groq. See docs/architecture.md.

# Backend (apps/backend). Local development only: the product does not use it, and it
# is not part of a public deployment. See "Deploying" in the README.
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Web (apps/web). NEXT_PUBLIC_* values are visible to everyone; no secrets here.
# Comma-separated extension IDs this site will talk to, most preferred first. Leave empty
# unless a store listing has its own ID: the pinned ID is used by default, everywhere.
NEXT_PUBLIC_DOPILOT_EXTENSION_IDS=
# Where visitors get the extension. Defaults to the latest GitHub release.
NEXT_PUBLIC_DOPILOT_EXTENSION_DOWNLOAD_URL=

# Extension release builds only (pnpm release:extension). Never needed for local work.
# DOPILOT_WEB_ORIGIN=https://your.domain   Leave out for a build that trusts no website.
# DOPILOT_KEEP_KEY=1   Keep the pinned key, to share an unpacked build. Stores refuse it.
# DOPILOT_MCP=1        Keep the local MCP bridge in a release build.
