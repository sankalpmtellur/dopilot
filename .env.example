# Copy to `.env` for local development. Never commit real values.
#
# There is deliberately no GROQ_API_KEY here. Users bring their own key, which
# stays in the extension and goes directly to Groq. See docs/architecture.md.

# Backend (apps/backend)
NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Web (apps/web). NEXT_PUBLIC_* values are visible to everyone; no secrets here.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:4000
# ID shown on chrome://extensions or brave://extensions after loading unpacked.
NEXT_PUBLIC_DOPILOT_EXTENSION_ID=
